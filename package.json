{
  "name": "sharapulina",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@sharapulina/api",
    "dev:web": "npm run dev --workspace=@sharapulina/web -- --host 0.0.0.0",
    "build": "npm run build --workspace=@sharapulina/api && npm run build --workspace=@sharapulina/web"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
